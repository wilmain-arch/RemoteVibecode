# Maintainer: wilmain <https://github.com/wilmain-arch>
pkgname=remotevibecode-agent
pkgver=1.1.0
pkgrel=1
pkgdesc='Графический агент RemoteVibecode для подключения ПК к своему ретранслятору'
arch=('any')
url='https://github.com/wilmain-arch/RemoteVibecode'
license=('MIT')
depends=('python' 'python-cryptography' 'python-pillow' 'python-qrcode' 'python-websockets' 'bubblewrap' 'util-linux' 'pyside6' 'qt6-svg' 'fontconfig' 'hicolor-icon-theme' 'polkit')
makedepends=('git')
optdepends=('git: статус, diff, ветки, коммиты и worktrees' 'android-tools: подключение и управление ADB')
source=("remotevibecode-source::git+https://github.com/wilmain-arch/RemoteVibecode.git#tag=arch-v$pkgver" 'LICENSE')
sha256sums=('SKIP' '77657ae5d4913dce589fc490aa382c84027ca729806797cc7279717d42cba062')

package() {
    local appdir="$pkgdir/usr/lib/remotevibecode-agent"
    install -Dm644 "$srcdir/remotevibecode-source/agent/windows_agent.py" "$appdir/agent/windows_agent.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/updates.py" "$appdir/agent/updates.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/update-public.pem" "$appdir/agent/update-public.pem"
    install -Dm644 "$srcdir/remotevibecode-source/agent/gui.py" "$appdir/agent/gui.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/controller.py" "$appdir/agent/controller.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/qt_theme.py" "$appdir/agent/qt_theme.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/remotevibecode-tray.ico" "$appdir/agent/remotevibecode-tray.ico"
    install -Dm644 "$srcdir/remotevibecode-source/agent/remotevibecode.ico" "$appdir/agent/remotevibecode.ico"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/__init__.py" "$appdir/bridge/__init__.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/codex_path.py" "$appdir/bridge/codex_path.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/controls.py" "$appdir/bridge/controls.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/workspace_listing.py" "$appdir/bridge/workspace_listing.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/interactions.py" "$appdir/bridge/interactions.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/server.py" "$appdir/bridge/server.py"
    local module
    for module in guest_access guest_jobs guest_scheduler guest_runner guest_runtime guest_resources guest_sandbox guest_executor_gateway; do
        install -Dm644 "$srcdir/remotevibecode-source/bridge/$module.py" "$appdir/bridge/$module.py"
    done
    install -Dm644 "$srcdir/remotevibecode-source/bridge/adb_devices.py" "$appdir/bridge/adb_devices.py"
    install -Dm755 "$srcdir/remotevibecode-source/arch/remotevibecode-agent" "$pkgdir/usr/bin/remotevibecode-agent"
    install -Dm644 "$srcdir/remotevibecode-source/arch/remotevibecode-agent.desktop" \
        "$pkgdir/usr/share/applications/remotevibecode-agent.desktop"
    install -Dm644 "$srcdir/remotevibecode-source/arch/remotevibecode-agent.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/remotevibecode-agent.svg"
    local size
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "$srcdir/remotevibecode-source/arch/icons/$size/remotevibecode-agent.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/remotevibecode-agent.png"
    done
    install -Dm644 "$srcdir/remotevibecode-source/agent/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/remotevibecode-agent/THIRD_PARTY_NOTICES.md"
    install -Dm644 "$srcdir/remotevibecode-source/agent/licenses/LGPL-3.0.txt" "$pkgdir/usr/share/licenses/remotevibecode-agent/LGPL-3.0.txt"
    install -Dm644 "$srcdir/remotevibecode-source/agent/licenses/GPL-3.0.txt" "$pkgdir/usr/share/licenses/remotevibecode-agent/GPL-3.0.txt"
    install -Dm644 "$srcdir/remotevibecode-source/agent/ui_preview.py" "$appdir/agent/ui_preview.py"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/remotevibecode-agent/LICENSE"
}
