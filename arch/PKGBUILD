# Maintainer: wilmain <https://github.com/wilmain-arch>
pkgname=remotevibecode-agent
pkgver=0.1.6
pkgrel=1
pkgdesc='Графический агент RemoteVibecode для подключения ПК к своему ретранслятору'
arch=('any')
url='https://github.com/wilmain-arch/RemoteVibecode'
license=('LicenseRef-Unspecified')
depends=('python' 'python-cryptography' 'python-pillow' 'python-qrcode' 'python-pystray' 'tk' 'fontconfig' 'hicolor-icon-theme')
makedepends=('git')
source=("remotevibecode-source::git+https://github.com/wilmain-arch/RemoteVibecode.git#tag=arch-v$pkgver" 'LICENSE')
sha256sums=('SKIP' 'afcd093d88c9d39b81948032f73ab8a5baabeeb2c9fd44989c9e6826e9d1f54d')

package() {
    local appdir="$pkgdir/usr/lib/remotevibecode-agent"
    install -Dm644 "$srcdir/remotevibecode-source/agent/windows_agent.py" "$appdir/agent/windows_agent.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/gui.py" "$appdir/agent/gui.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/dashboard.py" "$appdir/agent/dashboard.py"
    install -Dm644 "$srcdir/remotevibecode-source/agent/remotevibecode.ico" "$appdir/agent/remotevibecode.ico"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/__init__.py" "$appdir/bridge/__init__.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/codex_path.py" "$appdir/bridge/codex_path.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/server.py" "$appdir/bridge/server.py"
    install -Dm644 "$srcdir/remotevibecode-source/bridge/adb_devices.py" "$appdir/bridge/adb_devices.py"
    install -Dm755 "$srcdir/remotevibecode-source/arch/remotevibecode-agent" "$pkgdir/usr/bin/remotevibecode-agent"
    install -Dm644 "$srcdir/remotevibecode-source/arch/remotevibecode-agent.desktop" \
        "$pkgdir/usr/share/applications/remotevibecode-agent.desktop"
    install -Dm644 "$srcdir/remotevibecode-source/arch/remotevibecode-agent.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/remotevibecode-agent.png"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/remotevibecode-agent/LICENSE"
}
